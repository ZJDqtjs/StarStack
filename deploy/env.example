# /etc/starstack/env — 由 root:starstack 0640 保存，systemd 在读服务单元前加载。
#
# Agent 接入令牌：Provider Agent 必须带 --token 才能在这台 Broker 上注册节点。
# 没有它，任何一个扫到端口的脚本都能自称「8 核带 4090、0.01 点/秒」把自己塞进
# 调度池，然后等着领别人的原片。
#
# 生成一次：  openssl rand -hex 16
STARSTACK_AGENT_TOKEN=replace-me

# 生图 / 生视频工作台的上游 ComfyUI 地址。Broker 会把官方 /object_info、/prompt、
# /upload/image、/view、/history、/queue、/interrupt、/ws 等路由代理到
# /comfyui/api/ 下（复用平台登录会话）。不填时默认 http://127.0.0.1:8188，
# 未启动 ComfyUI 时前端自动进入离线编辑模式。
# STARSTACK_COMFYUI=http://127.0.0.1:8188

# AI 视频共享算力页（/comfy/ → ComfyHub:8788），与上面的节点工作台相互独立。
# STARSTACK_COMFYHUB=http://127.0.0.1:8788

# ---- 模型网关：平台自营上游（官方供给）与护栏 ----
# 全部可选；不配则播种完全不执行，行为与旧版本一致。任何播种失败只打日志、不影响启动。
# 上游是 upstreams 表里的普通行，与真实 provider 共用路由与 90/10 结算；不新增服务/端口。
# 只接厂商官方端点或明确聚合平台（白名单见 internal/hub/gateway_seed.go），禁止转售/拼车 key。
# 密钥只允许写在本文件（640 root:starstack），入库 AES-GCM 加密，切勿写进代码、日志或 git。
#
# STARSTACK_SEED_UPSTREAMS：单行 JSON 数组，字段说明见 README「平台自营上游」小节。
#   name / base_url / api_key / models / caps / max_context；
#   cost_in_yuan_per_1k、cost_out_yuan_per_1k 是厂商「元/千 token」成本；
#   markup 是参考价倍率（缺省 1.2）；也可直接给 price / price_out / price_cached（点/千 token）。
#   占位示例（不要填真实密钥）：
# STARSTACK_SEED_UPSTREAMS='[{"name":"<厂商名>","base_url":"https://<厂商官方端点>","api_key":"<KEY>","models":["<模型ID>"],"cost_in_yuan_per_1k":0.002,"cost_out_yuan_per_1k":0.008,"markup":1.35,"max_context":65536,"caps":["tools"]}]'
#
# 自营账户承载上游 owner 与收益；不存在时用下面的口令创建（口令至少 8 字符）。
# STARSTACK_PLATFORM_USER=starstack-platform
# STARSTACK_PLATFORM_PASSWORD=<平台自营账户口令>
#
# 点值：1 点等于多少人民币，默认 0.01；只用于播种时把厂商成本换算成点价，不进入结算。
# STARSTACK_POINT_YUAN=0.01
#
# 长上下文 / 长输出上限：默认 32768 / 8192；夹取上限分别为 1048576 / 131072，越界回落默认值。
# STARSTACK_GATEWAY_MAX_PROMPT=65536
# STARSTACK_GATEWAY_MAX_TOKENS=8192
#
# 平台级当日模型预算（点，0 = 不限）。公网档没有充值，务必配合新用户赠额设置；
# 单把密钥还可在控制台创建时设 daily_quota。预算用尽返回 503，密钥限额触发 429。
# STARSTACK_GATEWAY_DAILY_BUDGET=200
#
# 只有一家上游时的最小写法：直接给显式点价 price，省掉成本换算。
# 部分厂商网关不提供 /v1/models，播种探测会打一条失败日志（非致命，照样落库路由）；
# models 里的 ID 必须与厂商 /v1/chat/completions 返回的 model 字段逐字一致。
# caps 不确定就留空，宁少勿多；未填的输出/缓存单价沿用输入价。
# STARSTACK_SEED_UPSTREAMS='[{"name":"<厂商名>","base_url":"https://<厂商端点>/v1","api_key":"<KEY>","models":["<模型ID>"],"price":0.5,"max_context":32768}]'
