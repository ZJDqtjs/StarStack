# /etc/starstack/env — 由 root:starstack 0640 保存，systemd 在读服务单元前加载。
#
# Agent 接入令牌：Provider Agent 必须带 --token 才能在这台 Broker 上注册节点。
# 没有它，任何一个扫到端口的脚本都能自称「8 核带 4090、0.01 点/秒」把自己塞进
# 调度池，然后等着领别人的原片。
#
# 生成一次：  openssl rand -hex 16
STARSTACK_AGENT_TOKEN=replace-me

# 生图 / 生视频工作台的上游 ComfyUI 地址。Broker 会把官方 /object_info、/prompt、
# /upload/image、/view、/history、/queue、/interrupt、/ws 等路由代理到
# /comfyui/api/ 下（复用平台登录会话）。不填时默认 http://127.0.0.1:8188，
# 未启动 ComfyUI 时前端自动进入离线编辑模式。
# STARSTACK_COMFYUI=http://127.0.0.1:8188

# AI 视频共享算力页（/comfy/ → ComfyHub:8788），与上面的节点工作台相互独立。
# STARSTACK_COMFYHUB=http://127.0.0.1:8788
