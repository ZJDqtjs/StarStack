<Window x:Class="StarStack.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="星栈算力" Height="840" Width="1320" MinHeight="620" MinWidth="920"
        WindowStartupLocation="CenterScreen"
        Background="#f6f8fd">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Menu Grid.Row="0" Padding="4,2">
      <MenuItem Header="应用">
        <MenuItem Header="重新加载" InputGestureText="F5" Click="Reload_Click" />
        <MenuItem Header="在浏览器中打开" Click="OpenWeb_Click" />
        <Separator />
        <MenuItem Header="退出" Click="Exit_Click" />
      </MenuItem>
      <MenuItem Header="视图">
        <MenuItem Header="开发者工具" InputGestureText="F12" Click="DevTools_Click" />
        <MenuItem Header="实际大小（100%）" Click="ResetZoom_Click" />
      </MenuItem>
      <MenuItem Header="帮助">
        <MenuItem Header="关于星栈算力" Click="About_Click" />
      </MenuItem>
    </Menu>

    <Grid Grid.Row="1">
      <wv2:WebView2 x:Name="Web" />
      <Border x:Name="Overlay" Background="#f6f8fd">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560">
          <Border Width="48" Height="48" CornerRadius="12" HorizontalAlignment="Center" Margin="0,0,0,18">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#5a6bff" Offset="0" />
                <GradientStop Color="#8b5cf6" Offset="1" />
              </LinearGradientBrush>
            </Border.Background>
            <TextBlock Text="星" FontSize="23" FontWeight="SemiBold" Foreground="White"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="星栈算力" FontSize="24" FontWeight="SemiBold" Foreground="#3d4bd8" HorizontalAlignment="Center" />
          <TextBlock x:Name="ErrorText" Text="正在启动本地控制台…" Margin="0,14,0,0"
                     Foreground="#8b96b1" TextWrapping="Wrap" TextAlignment="Center" />
          <Button Content="重新加载" Click="Reload_Click" Margin="0,22,0,0" Padding="22,9"
                  Background="#5a6bff" Foreground="White" BorderThickness="0" FontWeight="SemiBold"
                  HorizontalAlignment="Center" />
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
