/* 星栈算力 · 小程序统一视觉
   与 Web 控制台 / React 客户端的新版体系对齐 */
page {
  --bg: #f6f8fd;
  --card: #ffffff;
  --ink: #141b33;
  --body: #4d5876;
  --mute: #8b96b1;
  --hair: #e7ebf5;
  --hair2: #d7deef;
  --soft: #f7f9ff;
  --inset: #f7f9ff;
  --link: #5a6bff;
  --link-soft: rgba(90, 107, 255, 0.12);
  --ok: #0a9f6e;
  --ok-soft: rgba(10, 159, 110, 0.12);
  --bad: #e0444f;
  --bad-soft: rgba(224, 68, 79, 0.12);
  --warn: #d9820b;
  --warn-soft: rgba(217, 130, 11, 0.14);
  --vio: #8b5cf6;
  --vio-soft: rgba(139, 92, 246, 0.14);
  --brand: #5a6bff;
  --brand-2: #8b5cf6;
  background: var(--bg);
  color: var(--body);
  font-size: 28rpx;
  line-height: 1.55;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
}

@media (prefers-color-scheme: dark) {
  page {
    --bg: #070a14;
    --card: #0f1526;
    --ink: #eef2ff;
    --body: #aab6d3;
    --mute: #7785a5;
    --hair: #222c45;
    --hair2: #303c5b;
    --soft: #141c30;
    --inset: #141c30;
    --link: #7f92ff;
    --link-soft: rgba(90, 107, 255, 0.2);
    --ok: #3dd68c;
    --ok-soft: rgba(61, 214, 140, 0.14);
    --bad: #ff6166;
    --bad-soft: rgba(255, 97, 102, 0.15);
    --warn: #f5a623;
    --warn-soft: rgba(245, 166, 35, 0.15);
    --vio: #a78bfa;
    --vio-soft: rgba(167, 139, 250, 0.16);
  }
}

.wrap { padding: 24rpx 28rpx 60rpx; box-sizing: border-box; }
h1 { font-size: 42rpx; font-weight: 650; color: var(--ink); letter-spacing: -0.5rpx; margin: 0 0 8rpx; }
h2 { font-size: 30rpx; font-weight: 650; color: var(--ink); margin: 0; }
h3 { font-size: 29rpx; font-weight: 600; color: var(--ink); margin: 0; }
.lead { font-size: 25rpx; color: var(--mute); margin-bottom: 20rpx; line-height: 1.6; }

/* ---------- 页面主视觉 ---------- */
.hero {
  display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap;
  padding: 32rpx 34rpx; margin-bottom: 22rpx; border-radius: 28rpx;
  background: linear-gradient(115deg, #3d4bd8, #695cf0 50%, #a855c7);
  box-shadow: 0 12rpx 30rpx rgba(74, 84, 214, 0.22);
}
.hero.create { background: linear-gradient(115deg, #e7548e, #a45ad8 52%, #5b6cff); }
.hero.compute { background: linear-gradient(115deg, #2f5bd8, #5b6cff 48%, #9b5de5); }
.hero.market { background: linear-gradient(115deg, #166f6a, #12a0a0 50%, #4a7de0); }
.hero.account { background: linear-gradient(115deg, #3b3f8f, #6a5cf0 52%, #c05aa8); }
.hero.community { background: linear-gradient(115deg, #d8547f, #f0728b 48%, #f6a06a); }
.hero-main { min-width: 0; flex: 1; }
.hero-eyebrow {
  display: block; font-size: 19rpx; letter-spacing: 2rpx; text-transform: uppercase;
  color: rgba(255, 255, 255, 0.84); font-family: 'SF Mono', Menlo, Consolas, monospace;
}
.hero-title { display: block; margin-top: 14rpx; font-size: 40rpx; font-weight: 650; letter-spacing: -1rpx; color: #ffffff; }
.hero-desc { display: block; margin-top: 10rpx; font-size: 23rpx; line-height: 1.7; color: rgba(255, 255, 255, 0.86); }
.hero-badge {
  min-width: 140rpx; padding: 16rpx 20rpx; margin-left: 18rpx; text-align: center;
  border-radius: 18rpx; border: 1rpx solid rgba(255, 255, 255, 0.3); background: rgba(255, 255, 255, 0.14);
}
.hero-badge-v { display: block; font-size: 34rpx; font-weight: 650; color: #ffffff; font-family: 'SF Mono', Menlo, Consolas, monospace; }
.hero-badge-k { display: block; margin-top: 4rpx; font-size: 19rpx; color: rgba(255, 255, 255, 0.86); }

.kpis { display: flex; flex-wrap: wrap; gap: 14rpx; margin-bottom: 22rpx; }
.kpi {
  flex: 1 0 28%; box-sizing: border-box; padding: 18rpx 20rpx; border-radius: 18rpx;
  background: var(--card); border: 1rpx solid var(--hair);
}
.kpi-v { display: block; font-size: 32rpx; font-weight: 650; color: var(--ink); font-family: 'SF Mono', Menlo, Consolas, monospace; }
.kpi-k { display: block; margin-top: 4rpx; font-size: 20rpx; color: var(--mute); }

.card {
  background: var(--card); border: 1rpx solid var(--hair); border-radius: 24rpx;
  padding: 28rpx; margin-bottom: 20rpx; box-sizing: border-box;
  box-shadow: 0 2rpx 12rpx rgba(20, 27, 51, 0.05);
}
.card-head { display: flex; align-items: center; flex-wrap: wrap; gap: 12rpx; margin-bottom: 16rpx; }
.kicker {
  font-size: 19rpx; letter-spacing: 1.2rpx; text-transform: uppercase;
  color: var(--link); background: var(--soft); padding: 4rpx 12rpx; border-radius: 8rpx;
}
.hint { font-size: 24rpx; color: var(--mute); line-height: 1.7; word-break: break-all; }
.hint.warn { color: var(--warn); }
.err { font-size: 25rpx; color: var(--bad); line-height: 1.6; }
.mono { font-family: 'SF Mono', Menlo, Consolas, monospace; }

.row { display: flex; gap: 18rpx; }
.row > .field { flex: 1; min-width: 0; }
.field { display: block; margin-top: 20rpx; }
.field-label { display: block; font-size: 24rpx; color: var(--body); font-weight: 600; margin-bottom: 10rpx; }
.in {
  width: 100%; height: 84rpx; line-height: 84rpx; padding: 0 22rpx; box-sizing: border-box;
  border: 1rpx solid var(--hair2); border-radius: 16rpx; background: var(--card);
  color: var(--ink); font-size: 28rpx;
}
.picker-in {
  display: flex; align-items: center; justify-content: space-between;
  height: 84rpx; padding: 0 22rpx; border: 1rpx solid var(--hair2); border-radius: 16rpx;
  background: var(--card); color: var(--ink); font-size: 28rpx;
}
.picker-in::after { content: '▾'; color: var(--mute); font-size: 22rpx; }
.textarea {
  width: 100%; box-sizing: border-box; min-height: 150rpx; padding: 18rpx 22rpx;
  border: 1rpx solid var(--hair2); border-radius: 16rpx; background: var(--card);
  color: var(--ink); font-size: 27rpx; line-height: 1.6;
}

.btn {
  height: 88rpx; line-height: 88rpx; text-align: center; border-radius: 16rpx;
  background: linear-gradient(120deg, #5a6bff, #8b5cf6); color: #ffffff;
  font-size: 29rpx; font-weight: 600; box-shadow: 0 8rpx 20rpx rgba(90, 107, 255, 0.22);
}
.btn.ghost { background: var(--card); color: var(--body); border: 1rpx solid var(--hair); box-shadow: none; }
.btn.tiny { height: 60rpx; line-height: 60rpx; font-size: 24rpx; padding: 0 22rpx; display: inline-block; box-shadow: none; }
.btn[disabled], .btn.disabled { opacity: 0.45; }
.btnrow { display: flex; gap: 16rpx; flex-wrap: wrap; margin-top: 20rpx; }
.btnrow .btn { flex: 1; }
.btnrow .btn.tiny { flex: 0 0 auto; }

.tag {
  display: inline-block; padding: 3rpx 14rpx; border-radius: 10rpx; font-size: 21rpx;
  background: var(--soft); color: var(--body); border: 1rpx solid var(--hair);
  margin: 0 8rpx 8rpx 0;
}
.tag.ok { background: var(--ok-soft); color: var(--ok); border-color: transparent; }
.tag.bad { background: var(--bad-soft); color: var(--bad); border-color: transparent; }
.tag.link { background: var(--link-soft); color: var(--link); border-color: transparent; }
.tag.vio { background: var(--vio-soft); color: var(--vio); border-color: transparent; }
.tag.warn { background: var(--warn-soft); color: var(--warn); border-color: transparent; }

.stats { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 18rpx; }
.stat {
  flex: 1 0 28%; background: var(--soft); border: 1rpx solid var(--hair);
  border-radius: 18rpx; padding: 16rpx 18rpx; box-sizing: border-box;
}
.stat .v { display: block; font-size: 32rpx; font-weight: 650; color: var(--ink); }
.stat .k { display: block; font-size: 19rpx; color: var(--mute); text-transform: uppercase; margin-top: 4rpx; }
.stat.hl { background: var(--link-soft); border-color: transparent; }
.stat.hl .v, .stat.hl .k { color: var(--link); }

.bar { height: 10rpx; background: var(--soft); border-radius: 99rpx; overflow: hidden; margin-top: 16rpx; }
.bar .fill { height: 100%; border-radius: 99rpx; background: linear-gradient(90deg, #5a6bff, #0fb5c9); }

.listrow { display: flex; gap: 16rpx; padding: 20rpx 0; border-bottom: 1rpx solid var(--hair); }
.listrow:last-child { border-bottom: 0; }
.listrow .grow { flex: 1; min-width: 0; }
.listrow .name { font-size: 28rpx; font-weight: 600; color: var(--ink); }
.listrow .meta { font-size: 23rpx; color: var(--mute); margin-top: 6rpx; line-height: 1.5; }
.amount { font-size: 27rpx; font-family: 'SF Mono', Menlo, monospace; white-space: nowrap; }
.amount.pos { color: var(--ok); }
.amount.neg { color: var(--warn); }

.empty {
  padding: 44rpx 20rpx; text-align: center; color: var(--mute); font-size: 25rpx;
  border: 1rpx dashed var(--hair2); border-radius: 20rpx; background: var(--soft);
}
.code {
  background: var(--soft); border: 1rpx solid var(--hair); border-radius: 18rpx;
  padding: 20rpx; font-family: 'SF Mono', Menlo, monospace; font-size: 21rpx;
  line-height: 1.65; word-break: break-all; white-space: pre-wrap;
}
.clip { color: var(--link); font-size: 24rpx; }

/* 自定义 tabBar 占位：内容不被底部导航遮住 */
.tabpage { padding-bottom: calc(env(safe-area-inset-bottom) + 210rpx); }

/* ---------- 渲染 / 编排工作台（与 Web / React 端同步） ---------- */
.wb-svc { display: grid; grid-template-columns: 1fr 1fr; gap: 6rpx; padding: 6rpx; margin-bottom: 22rpx; background: var(--soft); border: 1rpx solid var(--hair); border-radius: 18rpx; }
.wb-svc button { height: 64rpx; line-height: 64rpx; border-radius: 12rpx; font-size: 26rpx; color: var(--mute); background: none; }
.wb-svc button.on { background: var(--card); color: var(--link); font-weight: 600; box-shadow: 0 2rpx 12rpx rgba(20, 27, 51, 0.08); }

.wb-pagehead { display: flex; align-items: center; gap: 20rpx; margin-bottom: 22rpx; }
.wb-pagehead-ic {
  width: 88rpx; height: 88rpx; flex: 0 0 88rpx; border-radius: 24rpx; display: flex; align-items: center; justify-content: center;
  background: linear-gradient(135deg, #2f5bd8, #5b6cff 55%, #9b5de5); color: #fff; font-size: 40rpx;
  box-shadow: 0 10rpx 24rpx rgba(90, 107, 255, 0.3);
}
.wb-pagehead.build .wb-pagehead-ic { background: linear-gradient(135deg, #34406f, #5a6bff 55%, #17a2a2); box-shadow: 0 10rpx 24rpx rgba(23, 162, 162, 0.25); }
.wb-pagehead-txt { min-width: 0; flex: 1; }
.wb-eyebrow { display: block; font-size: 18rpx; letter-spacing: 2rpx; color: var(--link); font-family: 'SF Mono', Menlo, Consolas, monospace; }
.wb-title { display: block; margin-top: 6rpx; font-size: 38rpx; font-weight: 650; color: var(--ink); letter-spacing: -1rpx; }
.wb-desc { display: block; margin-top: 6rpx; font-size: 22rpx; line-height: 1.7; color: var(--mute); }

.wb-pipe { margin-bottom: 20rpx; }
.wb-pipe-step { padding: 24rpx; border: 1rpx solid var(--hair); border-radius: 20rpx; background: var(--card); box-shadow: 0 2rpx 12rpx rgba(20, 27, 51, 0.05); }
.wb-pipe-ic { display: inline-flex; align-items: center; justify-content: center; width: 60rpx; height: 60rpx; border-radius: 16rpx; background: var(--soft); color: var(--link); font-size: 28rpx; font-family: 'SF Mono', Menlo, Consolas, monospace; margin-bottom: 10rpx; }
.wb-pipe-t { display: block; font-size: 27rpx; font-weight: 650; color: var(--ink); }
.wb-pipe-d { display: block; margin-top: 6rpx; font-size: 22rpx; color: var(--mute); line-height: 1.6; }
.wb-pipe-line { width: 4rpx; height: 28rpx; margin: 6rpx auto; border-radius: 4rpx; background: linear-gradient(180deg, #5a6bff, #0fb5c9); }

.wb-tip { padding: 20rpx 24rpx; margin-bottom: 20rpx; border: 1rpx solid var(--hair); border-left: 6rpx solid var(--brand); border-radius: 16rpx; background: var(--soft); font-size: 23rpx; line-height: 1.75; color: var(--body); }

.wb-steps { display: flex; align-items: center; gap: 12rpx; flex-wrap: wrap; margin-bottom: 24rpx; }
.wb-step { display: inline-flex; align-items: center; gap: 10rpx; font-size: 22rpx; color: var(--mute); }
.wb-step-n { width: 36rpx; height: 36rpx; border-radius: 99rpx; display: inline-flex; align-items: center; justify-content: center; border: 1rpx solid var(--hair2); background: var(--card); font-size: 20rpx; font-family: 'SF Mono', Menlo, Consolas, monospace; color: var(--mute); }
.wb-step.cur { color: var(--ink); }
.wb-step.cur .wb-step-n { border-color: var(--brand); color: var(--link); box-shadow: 0 0 0 5rpx var(--link-soft); }
.wb-step.done { color: var(--ok); }
.wb-step.done .wb-step-n { background: var(--ok); border-color: transparent; color: #fff; }
.wb-step-line { width: 32rpx; height: 2rpx; background: var(--hair2); }

.wb-kinds { display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx; margin-bottom: 20rpx; }
.wb-kind { position: relative; display: flex; flex-direction: column; align-items: flex-start; gap: 8rpx; padding: 22rpx; border: 1rpx solid var(--hair); border-radius: 20rpx; background: var(--card); }
.wb-kind.on { border-color: var(--brand); background: linear-gradient(135deg, rgba(90, 107, 255, 0.08), rgba(139, 92, 246, 0.05)); box-shadow: 0 0 0 5rpx var(--link-soft); }
.wb-kind-ic { width: 56rpx; height: 56rpx; border-radius: 16rpx; display: flex; align-items: center; justify-content: center; background: var(--soft); color: var(--link); font-size: 26rpx; }
.wb-kind.on .wb-kind-ic { background: linear-gradient(135deg, #5a6bff, #8b5cf6); color: #fff; }
.wb-kind-t { font-size: 26rpx; font-weight: 650; color: var(--ink); }
.wb-kind-d { font-size: 20rpx; color: var(--mute); line-height: 1.5; }
.wb-kind-tag { padding: 2rpx 12rpx; border-radius: 8rpx; background: var(--soft); border: 1rpx solid var(--hair); font-size: 18rpx; color: var(--link); font-family: 'SF Mono', Menlo, Consolas, monospace; }
.wb-kind.on .wb-kind-tag { background: var(--link-soft); border-color: transparent; }

.wb-sec { display: flex; align-items: center; gap: 14rpx; margin: 28rpx 0 16rpx; font-size: 25rpx; font-weight: 650; color: var(--ink); }
.wb-sec-n { width: 36rpx; height: 36rpx; border-radius: 10rpx; display: inline-flex; align-items: center; justify-content: center; background: var(--soft); color: var(--link); font-size: 20rpx; font-family: 'SF Mono', Menlo, Consolas, monospace; }

.wb-drop { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10rpx; padding: 44rpx 24rpx; border: 2rpx dashed var(--hair2); border-radius: 20rpx; background: var(--soft); }
.wb-drop-ic { width: 72rpx; height: 72rpx; border-radius: 20rpx; display: flex; align-items: center; justify-content: center; background: var(--card); border: 1rpx solid var(--hair); color: var(--link); font-size: 32rpx; }
.wb-drop-t { font-size: 26rpx; font-weight: 650; color: var(--ink); }
.wb-drop-d { font-size: 21rpx; color: var(--mute); }
.wb-drop.has-file { flex-direction: row; justify-content: flex-start; padding: 22rpx 24rpx; border-style: solid; border-color: var(--hair); background: var(--card); }
.wb-file-ic { width: 56rpx; height: 56rpx; flex: 0 0 56rpx; border-radius: 14rpx; display: flex; align-items: center; justify-content: center; background: var(--soft); color: var(--link); font-size: 26rpx; }
.wb-file-name { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 24rpx; color: var(--ink); font-family: 'SF Mono', Menlo, Consolas, monospace; }
.wb-file-size { flex: 0 0 auto; font-size: 20rpx; color: var(--mute); font-family: 'SF Mono', Menlo, Consolas, monospace; }
.wb-file-x { flex: 0 0 auto; width: 48rpx; height: 48rpx; border-radius: 12rpx; border: 1rpx solid var(--hair); background: var(--card); color: var(--mute); font-size: 22rpx; display: flex; align-items: center; justify-content: center; }

.wb-cmd { display: flex; align-items: center; gap: 14rpx; padding: 0 22rpx; border: 1rpx solid var(--hair2); border-radius: 16rpx; background: var(--soft); }
.wb-cmd-ps { font-size: 26rpx; color: var(--link); font-family: 'SF Mono', Menlo, Consolas, monospace; font-weight: 600; }
.wb-cmd-in { flex: 1; height: 80rpx; line-height: 80rpx; font-size: 24rpx; color: var(--ink); font-family: 'SF Mono', Menlo, Consolas, monospace; }
.wb-cmd-chips { display: flex; gap: 12rpx; flex-wrap: wrap; margin-top: 14rpx; }
.wb-cmd-chip { height: 52rpx; line-height: 52rpx; padding: 0 20rpx; border: 1rpx solid var(--hair); border-radius: 99rpx; background: var(--card); color: var(--body); font-size: 21rpx; font-family: 'SF Mono', Menlo, Consolas, monospace; }

.wb-sumrows { margin-bottom: 20rpx; border: 1rpx solid var(--hair); border-radius: 16rpx; overflow: hidden; }
.wb-sumrow { display: flex; justify-content: space-between; gap: 18rpx; padding: 16rpx 22rpx; font-size: 23rpx; background: var(--soft); color: var(--mute); }
.wb-sumrow + .wb-sumrow { border-top: 1rpx solid var(--hair); }
.wb-sumrow .v { color: var(--ink); font-weight: 600; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.q-line { font-size: 23rpx; color: var(--body); line-height: 1.8; }
.q-total { display: flex; align-items: baseline; gap: 10rpx; flex-wrap: wrap; margin: 14rpx 0 8rpx; }
.q-label { font-size: 23rpx; color: var(--mute); }
.q-big { font-size: 56rpx; font-weight: 650; letter-spacing: -2rpx; color: var(--link); font-family: 'SF Mono', Menlo, Consolas, monospace; }
.q-total.no .q-big { color: var(--warn); }
.q-unit { font-size: 23rpx; color: var(--body); }
.q-basis { width: 100%; font-size: 20rpx; color: var(--mute); }
