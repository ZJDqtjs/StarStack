.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  background: rgba(255, 255, 255, 0.96);
  border-top: 1rpx solid #e7ebf5;
  padding-bottom: env(safe-area-inset-bottom);
  box-shadow: 0 -6rpx 24rpx rgba(20, 27, 51, 0.06);
}

.items {
  display: flex;
  height: 128rpx;
  align-items: center;
}

.item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100%;
}

.pill {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  padding: 10rpx 24rpx;
  border-radius: 20rpx;
  transition: background 0.15s;
}

.item.on .pill {
  background: linear-gradient(135deg, rgba(90, 107, 255, 0.16), rgba(139, 92, 246, 0.1));
}

.icon {
  width: 52rpx;
  height: 52rpx;
}

.label {
  font-size: 24rpx;
  line-height: 1.2;
  color: #8b96b1;
}

.item.on .label {
  color: #5a6bff;
  font-weight: 600;
}

@media (prefers-color-scheme: dark) {
  .tabbar {
    background: rgba(15, 21, 38, 0.97);
    border-top-color: #222c45;
    box-shadow: 0 -6rpx 24rpx rgba(0, 0, 0, 0.35);
  }
  .item.on .pill {
    background: rgba(90, 107, 255, 0.22);
  }
  .label {
    color: #7785a5;
  }
  .item.on .label {
    color: #8fa2ff;
  }
}
