{
  "name": "starstack-apps",
  "private": true,
  "type": "module",
  "scripts": {
    "build:web": "npm --prefix ../web-react run build",
    "sync:core": "esbuild shared/index.js --bundle --format=cjs --platform=neutral --target=es2017 --outfile=miniapp/utils/core.js",
    "sync:harmony": "node scripts/sync-harmony.cjs",
    "sync:all": "npm run build:web && npm run sync:core && npm run sync:harmony",
    "verify:miniapp": "node scripts/verify-miniapp.cjs",
    "verify:sync": "node ../scripts/verify-console-sync.cjs"
  },
  "devDependencies": {
    "esbuild": "^0.24.2"
  }
}
