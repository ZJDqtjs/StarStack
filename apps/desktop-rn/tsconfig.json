{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "allowJs": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "strict": false,
    "skipLibCheck": true,
    "types": [],
    "baseUrl": ".",
    "paths": {
      "react": ["./node_modules/@types/react"],
      // 共享页面在 ../mobile-rn/src 下，CI 里那边没有 node_modules，
      // 不显式映射子路径的话 tsc 会报 TS2875（react/jsx-runtime 找不到）。
      "react/jsx-runtime": ["./node_modules/@types/react/jsx-runtime"],
      "react/jsx-dev-runtime": ["./node_modules/@types/react/jsx-dev-runtime"],
      "react-native": ["./node_modules/react-native"],
      "react-native-svg": ["./node_modules/react-native-svg"],
      "@react-native-async-storage/async-storage": ["./node_modules/@react-native-async-storage/async-storage"]
    }
  },
  // 只收桌面端真正用到的共享文件：../mobile-rn/src 里的 platform-expo.tsx 与 native/
  // 依赖 expo-*（桌面工程不装 Expo），整目录 include 会把它们也拉进来编，CI 直接 TS2307。
  "include": [
    "index.js",
    "App.tsx",
    "src",
    "../mobile-rn/src/screens",
    "../mobile-rn/src/api",
    "../mobile-rn/src/ui",
    "../mobile-rn/src/theme.tsx",
    "../mobile-rn/src/ctx.tsx",
    "../mobile-rn/src/session.ts",
    "../mobile-rn/src/platform.tsx",
    "../mobile-rn/src/agent.ts"
  ]
}
